# Copy to .env and fill in. Every variable is read by src/ at startup.

# development: e-mails without RESEND_API_KEY are printed to the console, APP_URL defaults to localhost.
# production: APP_URL and RESEND_API_KEY are required, the session cookie is Secure.
# docker-compose.yml always sets NODE_ENV=production and DB_PATH for the container.
NODE_ENV=development
PORT=3000

# Public address of the site (https://...). Links in e-mails and link previews are built from it.
APP_URL=http://localhost:3000

# Signs the session cookies. Generate it: openssl rand -hex 32 (at least 32 characters).
# The app refuses to start with this placeholder, a short or a repetitive value
# (ALLOW_WEAK_SECRETS=true turns the error into a warning, for local work only).
# The README quick start appends a generated JWT_SECRET line at the end of .env; the last one wins.
JWT_SECRET=CHANGE_ME

# Optional: key for hashing the IP address of visitors from the leaflet QR code (/qr), at least 32 characters.
# Without it the key is derived from JWT_SECRET. Changing it makes new hashes differ from the stored ones.
# IP_HASH_SECRET=

# Administrator accounts, comma-separated. The admin login link is sent ONLY to these addresses, and admin rights are
# checked against this list on every request: after a restart without an address, its open sessions lose them too.
ADMIN_EMAILS=admin@example.com

# Instructors are not configured here: an administrator adds and removes them at /admin/instructors.

# Resend API key (https://resend.com/api-keys). Optional outside production.
RESEND_API_KEY=

# Public contact address: footer, privacy policy, e-mail body and the default Reply-To.
CONTACT_EMAIL=contact@example.com

# Sender address; its domain must be verified in Resend. Default: noreply@<host of APP_URL>.
# For a first test you can use onboarding@resend.dev
# EMAIL_FROM=Fantastyczne Wspinanie <noreply@example.com>

# SQLite database file. Default: data/climbing-booking.db in the project directory.
# DB_PATH=./data/climbing-booking.db

# Rate limits (defaults shown). The general limit counts every request except /healthz and static files.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAGIC_LINK_RATE_LIMIT_MAX=5
MAGIC_LINK_EMAIL_LIMIT_MAX=3
