# Aplikacja
NODE_ENV=production
PORT=3000
# Publiczny adres strony (https://...). Wymagany w produkcji: z niego powstają linki w e-mailach.
APP_URL=https://twoja-domena.pl

# Sekret podpisujący sesje: wygeneruj go (openssl rand -hex 32), min. 32 znaki.
# Aplikacja nie wystartuje z placeholderem, krótkim ani powtarzalnym sekretem
# (ALLOW_WEAK_SECRETS=true zamienia błąd w ostrzeżenie, tylko do pracy lokalnej).
JWT_SECRET=CHANGE_ME

# Konta administratorów (oddzielone przecinkiem)
# Magic link logowania do panelu admina będzie wysyłany TYLKO na te adresy
ADMIN_EMAILS=admin@example.com

# Konta instruktorów: adres:Imię, oddzielone przecinkiem (tworzone przy starcie)
INSTRUCTORS=instruktor@example.com:Anna

# Resend — API do wysyłki e-maili (https://resend.com)
# Wygeneruj klucz w: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Publiczny adres kontaktowy: stopka, polityka prywatności, treść maili i domyślny Reply-To
CONTACT_EMAIL=contact@example.com

# Adres nadawcy (musi być zweryfikowaną domeną w Resend)
# Bez tej zmiennej nadawcą jest noreply@<host z APP_URL>.
# Na czas testów możesz użyć: onboarding@resend.dev
EMAIL_FROM=Fantastyczne Wspinanie <noreply@twoja-domena.pl>

# Baza danych SQLite
DB_PATH=/app/data/skarpa.db

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAGIC_LINK_RATE_LIMIT_MAX=5
