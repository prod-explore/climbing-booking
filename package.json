{
  "name": "climbing-booking",
  "version": "1.0.0",
  "private": true,
  "description": "Class registration for a climbing school: schedule, adult and child capacity pools, waiting list, magic-link login",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "test": "jest",
    "lint": "eslint .",
    "seed": "node scripts/seed-demo.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "resend": "^3.2.0",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=22"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/__tests__/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/src/__tests__/helpers/quietConsole.js"
    ]
  }
}
